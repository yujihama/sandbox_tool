OPENAI_API_KEY=
SANDBOX_CONTROLLER_TOKEN=
SANDBOX_BACKEND=controller
RUNS_ROOT_HOST=/srv/sandbox-tool/runs
INPUTS_HOST=/srv/sandbox-tool/inputs
SANDBOX_SOCKET_HOST=/var/run/docker.sock
SANDBOX_CONTROLLER_PORT=8080
SANDBOX_IMAGE_ALLOWLIST=localhost/python-data-sandbox:latest,localhost/python-browser-sandbox:latest
SANDBOX_CONTAINER_USER=1000:1000
SANDBOX_MEMORY_LIMIT=2g
SANDBOX_PIDS_LIMIT=256
SANDBOX_CPUS=2
RUN_DIR_MODE=0777
